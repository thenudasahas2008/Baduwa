# ============================================================
#  Music Bot — .env.example
#  Me file eka COPY karala ".env" kiyyala rename karanna,
#  values tika fill karanna. (.env git ekata commit karanna nae!)
# ============================================================

# --- REQUIRED ------------------------------------------------
# Discord bot token eka (docs/SETUP.md eke step 2)
DISCORD_TOKEN=

# Application ID eka (docs/SETUP.md eke step 3 — General Information tab eke thiyenawa)
CLIENT_ID=

# --- OPTIONAL: Spotify links -----------------------------
# Free credentials: docs/SETUP.md eke "Spotify Support" section eka
# (naethnam Spotify links podi patabela / fail wenawa. YouTube links saha
#  song name search mekakuth auwk nae.)
DP_SPOTIFY_CLIENT_ID=
DP_SPOTIFY_CLIENT_SECRET=

# --- OPTIONAL: YouTube cookie ----------------------------
# Free hosting / datacenter IP wita YouTube "bot-gate" karana wita meka
# weda karala denawa. Format eka (full browser cookie header eka):
# YOUTUBE_COOKIE=VISITOR_INFO1_LIVE=xxx; YSC=xxx; ...full value eka...
# Steps: docs/SETUP.md eke "YouTube Cookie" section eka
YOUTUBE_COOKIE=
